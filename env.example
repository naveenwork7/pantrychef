# Add whichever keys you have. The app tries them in order and falls back automatically.
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Recommended once the app is public
APP_PASSWORD=

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# GITHUB_MODEL=openai/gpt-4.1
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENROUTER_MODEL=google/gemma-3-27b-it:free
# CEREBRAS_MODEL=gpt-oss-120b
# Optional: change the order providers are tried
# VISION_ORDER=gemini,github,groq,openrouter
# TEXT_ORDER=cerebras,groq,gemini,github,openrouter
